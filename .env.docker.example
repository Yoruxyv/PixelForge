# Browser access
PIXELFORGE_FRONTEND_PORT=8080
PIXELFORGE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Local Docker PostgreSQL
POSTGRES_DB=pixelforge
POSTGRES_USER=pixelforge
POSTGRES_PASSWORD=pixelforge-local

# External services — copy real values from backend/.env
AZURE_CONNECTION_STRING=
REPLICATE_API_TOKEN=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
DISCORD_WEBHOOK_URL=

# Public frontend value — copy from frontend/.env
VITE_TURNSTILE_SITE_KEY=

# Container logging
LOG_LEVEL=INFO